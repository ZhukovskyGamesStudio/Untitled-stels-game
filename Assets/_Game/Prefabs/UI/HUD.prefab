    m_HorizontalOverflow: 0
    m_VerticalOverflow: 0
    m_LineSpacing: 1
  m_Text: "WASD \u2014 \u0445\u043E\u0434\u0438\u0442\u044C \xB7 Shift \u2014 \u0431\u0435\u0433 \xB7 \u041F\u0440\u043E\u0431\u0435\u043B \u2014 \u043F\u0440\u044B\u0436\u043E\u043A \xB7 Ctrl/C \u2014 \u043F\u0440\u0438\u0441\u0435\u0441\u0442\u044C\nTab (\u0434\u0435\u0440\u0436\u0430\u0442\u044C) \u2014 \u0440\u0443\u043A\u0438: \u0442\u0430\u0449\u0438 \u043F\u0440\u0435\u0434\u043C\u0435\u0442\u044B \u043C\u044B\u0448\u043A\u043E\u0439, R \u2014 \u043F\u043E\u0432\u0435\u0440\u043D\u0443\u0442\u044C\nE \u2014 \u043F\u043E\u0434\u043D\u044F\u0442\u044C \u0441\u043E\u044E\u0437\u043D\u0438\u043A\u0430 / \u0432\u0437\u043B\u043E\u043C\u0430\u0442\u044C \xB7 F \u0443 \u043B\u044E\u043A\u0430 \u2014 \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0438\u0439 \u0434\u043E\u043C \xB7 Esc \u2014 \u043C\u0435\u043D\u044E \xB7 H \u2014 \u0441\u043F\u0440\u0430\u0432\u043A\u0430"
