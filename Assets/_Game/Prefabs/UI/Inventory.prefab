    m_VerticalOverflow: 1
    m_LineSpacing: 1
  m_Text: "\u041A\u0430\u0436\u0434\u044B\u0439 \u0437\u0430\u0431\u0435\u0433 \u0440\u0435\u0446\u0435\u043F\u0442\u044B \u0440\u0430\u0437\u043D\u044B\u0435.\n\u041D\u0430\u0445\u043E\u0434\u0438\u0442\u0435 \u0447\u0435\u0440\u0442\u0435\u0436\u0438, \u0447\u0442\u043E\u0431\u044B \u0443\u0437\u043D\u0430\u0442\u044C \u043D\u043E\u0432\u044B\u0435 \u0440\u0435\u0446\u0435\u043F\u0442\u044B.\n\u041F\u0440\u0438 \u043D\u0435\u0443\u0434\u0430\u0447\u043D\u043E\u043C \u043E\u0431\u044A\u0435\u0434\u0438\u043D\u0435\u043D\u0438\u0438 \u043E\u0434\u0438\u043D \u0438\u0437 \u043F\u0440\u0435\u0434\u043C\u0435\u0442\u043E\u0432 \u043B\u043E\u043C\u0430\u0435\u0442\u0441\u044F \u0441 \u0448\u0430\u043D\u0441\u043E\u043C 50%."
