  m_Name: S03_Heist
  m_EditorClassIdentifier: Stealth.Game::Stealth.Configs.VisualStyle
  Title: "\u041E\u0433\u0440\u0430\u0431\u043B\u0435\u043D\u0438\u0435"
  References: PAYDAY 2, Hitman
  Pitch: "\u0411\u0430\u043D\u043A \u043D\u043E\u0447\u044C\u044E: \u043C\u0440\u0430\u043C\u043E\u0440\u043D\u044B\u0439 \u043F\u043E\u043B, \u0441\u0432\u0435\u0442\u043B\u0430\u044F \u0448\u0442\u0443\u043A\u0430\u0442\u0443\u0440\u043A\u0430, \u043F\u0438\u043B\u044F\u0441\u0442\u0440\u044B \u0443 \u0434\u0432\u0435\u0440\u0435\u0439, \u043A\u0435\u0441\u0441\u043E\u043D\u043D\u044B\u0439 \u043F\u043E\u0442\u043E\u043B\u043E\u043A, \u043A\u0430\u0440\u043D\u0438\u0437\u044B \u0438 \u043F\u043B\u0438\u043D\u0442\u0443\u0441\u044B. \u0425\u043E\u043B\u043E\u0434\u043D\u044B\u0435 \u0431\u0438\u0440\u044E\u0437\u043E\u0432\u044B\u0435 \u0442\u0435\u043D\u0438, \u0442\u0451\u043F\u043B\u044B\u0435 \u043B\u0430\u043C\u043F\u044B, \u0433\u043B\u044F\u043D\u0435\u0446. \u0421\u0435\u0440\u044C\u0451\u0437\u043D\u043E \u0438 \u0434\u043E\u0440\u043E\u0433\u043E."
