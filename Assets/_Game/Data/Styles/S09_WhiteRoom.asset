  m_EditorClassIdentifier: Stealth.Game::Stealth.Configs.VisualStyle
  Title: "\u0411\u0435\u043B\u0430\u044F \u043A\u043E\u043C\u043D\u0430\u0442\u0430"
  References: SUPERHOT, Mirror's Edge
  Pitch: "\u0411\u0435\u043B\u044B\u0435 \u043F\u0430\u043D\u0435\u043B\u0438, \u0441\u0432\u0435\u0442\u044F\u0449\u0438\u0435\u0441\u044F \u0449\u0435\u043B\u0438 \u0432 \u0441\u0442\u0435\u043D\u0430\u0445, \u0431\u0435\u0442\u043E\u043D\u043D\u044B\u0439 \u043F\u043E\u043B. \u0420\u043E\u0431\u043E\u0442\u044B \u2014 \u0433\u0440\u0430\u043D\u0451\u043D\u044B\u0435 \u043A\u0440\u0430\u0441\u043D\u044B\u0435 \u043A\u0440\u0438\u0441\u0442\u0430\u043B\u043B\u044B, \u043B\u0443\u0442 \u2014 \u0435\u0434\u0438\u043D\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u0435 \u043A\u0440\u0430\u0441\u043A\u0438. \u0422\u043E\u043B\u044C\u043A\u043E \u0441\u0438\u043B\u0443\u044D\u0442\u044B \u0438 \u0443\u0433\u0440\u043E\u0437\u044B."
