  m_Name: S11_Noir
  m_EditorClassIdentifier: Stealth.Game::Stealth.Configs.VisualStyle
  Title: "\u041D\u0443\u0430\u0440-\u0434\u0435\u0442\u0435\u043A\u0442\u0438\u0432"
  References: "\u043F\u043E \u043C\u043E\u0442\u0438\u0432\u0430\u043C Shadows of Doubt, Blade Runner"
  Pitch: "\u041d\u043e\u0447\u043d\u043e\u0439 \u0433\u043e\u0440\u043e\u0434 \u0437\u0430 \u043e\u043a\u043d\u043e\u043c \u0438 \u043a\u043e\u043d\u0442\u043e\u0440\u0430 \u0434\u0435\u0442\u0435\u043a\u0442\u0438\u0432\u0430: \u043a\u043e\u0432\u0440\u043e\u043b\u0438\u043d, \u043e\u0431\u043e\u0438 \u0441 \u0443\u0437\u043e\u0440\u043e\u043c, \u0442\u0451\u043c\u043d\u044b\u0435 \u0434\u0435\u0440\u0435\u0432\u044f\u043d\u043d\u044b\u0435 \u043f\u0430\u043d\u0435\u043b\u0438. \u0420\u043e\u0431\u043e\u0442\u044b, \u043c\u0435\u0431\u0435\u043b\u044c \u0438 \u043b\u044e\u0434\u0438 \u0441\u043e\u0431\u0440\u0430\u043d\u044b \u0438\u0437 \u0432\u043e\u043a\u0441\u0435\u043b\u0435\u0439 (4 \u0441\u043c), \u043a\u0430\u0440\u0442\u0438\u043d\u043a\u0430 \u0447\u0451\u0442\u043a\u0430\u044f, \u043c\u0430\u043b\u043e \u0446\u0432\u0435\u0442\u043e\u0432. \u0421\u0438\u043d\u0438\u0435 \u0442\u0435\u043d\u0438, \u044f\u043d\u0442\u0430\u0440\u043d\u044b\u0435 \u043b\u0430\u043c\u043f\u044b, \u0434\u043e\u0436\u0434\u043b\u0438\u0432\u0430\u044f \u0434\u044b\u043c\u043a\u0430."
