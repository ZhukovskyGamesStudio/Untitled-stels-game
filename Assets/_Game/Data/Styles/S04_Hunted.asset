  m_Name: S04_Hunted
  m_EditorClassIdentifier: Stealth.Game::Stealth.Configs.VisualStyle
  Title: "\u0422\u0443\u043C\u0430\u043D \u0438 \u0442\u0432\u0438\u0434"
  References: Sir, You Are Being Hunted, Pathologic
  Pitch: "\u0421\u0442\u0430\u0440\u044B\u0439 \u0430\u043D\u0433\u043B\u0438\u0439\u0441\u043A\u0438\u0439 \u0434\u043E\u043C: \u043A\u0438\u0440\u043F\u0438\u0447, \u043E\u0431\u043B\u0435\u0437\u043B\u0430\u044F \u0448\u0442\u0443\u043A\u0430\u0442\u0443\u0440\u043A\u0430, \u0434\u043E\u0441\u043A\u0438 \u043D\u0430 \u043F\u043E\u043B\u0443 \u0438 \u0442\u0451\u043C\u043D\u044B\u0435 \u0431\u0430\u043B\u043A\u0438, \u0432\u0441\u0451 \u0447\u0443\u0442\u044C \u043A\u0440\u0438\u0432\u043E\u0435, \u043A\u0430\u043A \u0441\u0434\u0435\u043B\u0430\u043D\u043D\u043E\u0435 \u0440\u0443\u043A\u0430\u043C\u0438. \u0416\u0451\u043B\u0442\u043E-\u043E\u043B\u0438\u0432\u043A\u043E\u0432\u0430\u044F \u0434\u044B\u043C\u043A\u0430, \u043A\u0430\u0440\u0442\u0438\u043D\u043A\u0430 \u043A\u0430\u043A \u043C\u0430\u0441\u043B\u043E."
