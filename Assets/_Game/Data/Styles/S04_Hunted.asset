  m_Name: S04_Hunted
  m_EditorClassIdentifier: Stealth.Game::Stealth.Configs.VisualStyle
  Title: "\u0422\u0443\u043C\u0430\u043D \u0438 \u0442\u0432\u0438\u0434"
  References: Sir, You Are Being Hunted, Pathologic
  Pitch: "\u0416\u0438\u0432\u043E\u043F\u0438\u0441\u043D\u0430\u044F \u0441\u0435\u0440\u043E-\u0437\u0435\u043B\u0451\u043D\u0430\u044F \u043F\u0430\u0441\u043C\u0443\u0440\u043D\u043E\u0441\u0442\u044C: \u043A\u0430\u0440\u0442\u0438\u043D\u043A\u0430 \u043A\u0430\u043A \u043C\u0430\u0441\u043B\u043E, \u043C\u044F\u0433\u043A\u0438\u0439 \u0431\u043B\u0435\u0434\u043D\u044B\u0439 \u0442\u0443\u043C\u0430\u043D \u0434\u0430\u0436\u0435 \u0432\u043D\u0443\u0442\u0440\u0438, \u0432\u044B\u0446\u0432\u0435\u0442\u0448\u0438\u0435 \u0446\u0432\u0435\u0442\u0430. \u0422\u0440\u0435\u0432\u043E\u0436\u043D\u043E \u0438 \u043F\u043E-\u0431\u0440\u0438\u0442\u0430\u043D\u0441\u043A\u0438."
