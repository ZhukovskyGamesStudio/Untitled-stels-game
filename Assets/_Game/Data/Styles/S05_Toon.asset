  m_Name: S05_Toon
  m_EditorClassIdentifier: Stealth.Game::Stealth.Configs.VisualStyle
  Title: "\u041C\u0443\u043B\u044C\u0442\u044F\u0448\u043D\u044B\u0439 \u0440\u0435\u0439\u0434"
  References: Risk of Rain 2, Deep Rock Galactic, PEAK
  Pitch: "\u0413\u0440\u0430\u043D\u0451\u043D\u044B\u0435 \u043C\u043E\u0434\u0435\u043B\u0438 \u0441 \u043F\u043B\u043E\u0441\u043A\u0438\u043C\u0438 \u0433\u0440\u0430\u043D\u044F\u043C\u0438, \u0441\u043E\u0447\u043D\u044B\u0435 \u0442\u0451\u043F\u043B\u044B\u0435 \u0441\u0442\u0435\u043D\u044B, \u043A\u0440\u0443\u043F\u043D\u0430\u044F \u043F\u043B\u0438\u0442\u043A\u0430, \u043C\u044F\u0433\u043A\u0438\u0435 \u0441\u0442\u0443\u043F\u0435\u043D\u0438 \u0441\u0432\u0435\u0442\u0430 \u0438 \u0446\u0432\u0435\u0442\u043D\u0430\u044F \u0434\u044B\u043C\u043A\u0430 \u0432 \u0433\u043B\u0443\u0431\u0438\u043D\u0435. \u0411\u0435\u0437 \u0447\u0451\u0440\u043D\u044B\u0445 \u043A\u043E\u043D\u0442\u0443\u0440\u043E\u0432: \u0441\u0438\u043B\u0443\u044D\u0442\u044B \u0434\u0435\u0440\u0436\u0438\u0442 \u0446\u0432\u0435\u0442."
