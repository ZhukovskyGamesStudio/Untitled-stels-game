  m_Name: S05_Toon
  m_EditorClassIdentifier: Stealth.Game::Stealth.Configs.VisualStyle
  Title: "\u041C\u0443\u043B\u044C\u0442\u044F\u0448\u043D\u044B\u0439 \u0440\u0435\u0439\u0434"
  References: Risk of Rain 2, Deep Rock Galactic
  Pitch: "\u0426\u0435\u043B-\u0448\u0435\u0439\u0434\u0438\u043D\u0433 \u0432 \u0447\u0435\u0442\u044B\u0440\u0435 \u0441\u0442\u0443\u043F\u0435\u043D\u0438, \u0446\u0432\u0435\u0442\u043D\u044B\u0435 \u043A\u043E\u043D\u0442\u0443\u0440\u044B, \u0441\u043E\u0447\u043D\u044B\u0435 \u0446\u0432\u0435\u0442\u0430 \u0438 \u0444\u0438\u043E\u043B\u0435\u0442\u043E\u0432\u0430\u044F \u0434\u044B\u043C\u043A\u0430. \u0421\u0440\u0430\u0437\u0443 \u0432\u0438\u0434\u043D\u043E, \u043A\u0442\u043E \u0433\u0434\u0435, \u2014 \u0430\u0440\u0442, \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u0445\u043E\u0440\u043E\u0448\u043E \u0447\u0438\u0442\u0430\u0435\u0442\u0441\u044F \u0432 \u0445\u0430\u043E\u0441\u0435."
