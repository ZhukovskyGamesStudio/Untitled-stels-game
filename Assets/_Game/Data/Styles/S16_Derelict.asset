  m_Script: {fileID: 11500000, guid: 4eee73b845c8c9542ac183ba3c160299, type: 3}
  m_Name: S16_Derelict
  m_EditorClassIdentifier: Stealth.Game::Stealth.Configs.VisualStyle
  Title: "\u0422\u0438\u0445\u0438\u0439 \u043A\u043E\u043C\u043F\u043B\u0435\u043A\u0441"
  References: 'Dead Space, SOMA, Alien: Isolation, Signalis'
  Pitch: "\u041D\u043E\u0447\u043D\u043E\u0439 \u043A\u043E\u043C\u043F\u043B\u0435\u043A\u0441, \u0433\u0434\u0435 \u0434\u0430\u0432\u043D\u043E \u043D\u0438\u043A\u043E\u0433\u043E \u043D\u0435\u0442: \u043D\u0430\u0441\u0442\u043E\u044F\u0449\u0438\u0435 \u043C\u0430\u0442\u0435\u0440\u0438\u0430\u043B\u044B \u2014 \u0431\u0435\u0442\u043E\u043D, \u043A\u0440\u0430\u0441\u043A\u0430, \u043F\u043B\u0438\u0442\u043A\u0430, \u043A\u043E\u0432\u0440\u043E\u043B\u0438\u043D, \u0443 \u043A\u0430\u0436\u0434\u043E\u0439 \u043A\u043E\u043C\u043D\u0430\u0442\u044B \u0441\u0432\u043E\u0438. \u041F\u043E\u0447\u0442\u0438 \u0442\u0435\u043C\u043D\u043E \u2014 \u0441\u0432\u0435\u0442\u044F\u0442 \u0442\u043E\u043B\u044C\u043A\u043E \u043B\u0430\u043C\u043F\u044B. \u0421\u0432\u043E\u0438 \u0446\u0432\u0435\u0442\u0430 \u043C\u0430\u0442\u0435\u0440\u0438\u0430\u043B\u043E\u0432, \u0437\u0435\u0440\u043D\u043E, \u043C\u0451\u0440\u0442\u0432\u044B\u0439 \u0433\u043E\u0440\u043E\u0434 \u0437\u0430 \u043E\u043A\u043D\u0430\u043C\u0438; \u0443 \u043A\u0430\u0436\u0434\u043E\u0433\u043E \u0434\u043E\u043C\u0430 \u0441\u0432\u043E\u0439 \u0432\u0438\u0434. \u041C\u043E\u0434\u0435\u043B\u0438 \u0440\u0435\u0430\u043B\u0438\u0441\u0442\u0438\u0447\u043D\u044B\u0435, \u043B\u044E\u0434\u0438 \u043F\u043E\u0445\u043E\u0436\u0438 \u043D\u0430 \u043B\u044E\u0434\u0435\u0439."
