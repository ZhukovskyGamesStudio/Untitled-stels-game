  m_Name: S16_Derelict
  m_EditorClassIdentifier: Stealth.Game::Stealth.Configs.VisualStyle
  Title: "\u0417\u0430\u0431\u0440\u043E\u0448\u0435\u043D\u043D\u044B\u0439 \u043A\u043E\u043C\u043F\u043B\u0435\u043A\u0441"
  References: 'Dead Space, SOMA, Alien: Isolation, Signalis'
  Pitch: "\u0411\u0440\u043E\u0448\u0435\u043D\u043D\u0430\u044F \u043D\u0430\u0443\u0447\u043D\u0430\u044F \u0441\u0442\u0430\u043D\u0446\u0438\u044F: \u0433\u0440\u044F\u0437\u043D\u044B\u0439 \u0431\u0435\u0442\u043E\u043D, \u0440\u0436\u0430\u0432\u044B\u0435 \u0442\u0440\u0443\u0431\u044B \u0438 \u043A\u0430\u0431\u0435\u043B\u044C\u043D\u044B\u0435 \u043B\u043E\u0442\u043A\u0438, \u0441\u0442\u0430\u043B\u044C\u043D\u044B\u0435 \u043F\u043B\u0438\u0442\u044B. \u041F\u043E\u0447\u0442\u0438 \u0442\u0435\u043C\u043D\u043E \u2014 \u0441\u0432\u0435\u0442\u044F\u0442 \u0442\u043E\u043B\u044C\u043A\u043E \u0443\u043C\u0438\u0440\u0430\u044E\u0449\u0438\u0435 \u043B\u0430\u043C\u043F\u044B \u0438 \u0440\u0435\u0434\u043A\u0438\u0435 \u0445\u043E\u043B\u043E\u0434\u043D\u044B\u0435 \u0449\u0435\u043B\u0438 \u044D\u043B\u0435\u043A\u0442\u0440\u043E\u043D\u0438\u043A\u0438. \u0411\u0438\u0440\u044E\u0437\u043E\u0432\u043E-\u0431\u043E\u043B\u0435\u0437\u043D\u0435\u043D\u043D\u0430\u044F \u0433\u0430\u043C\u043C\u0430, \u0437\u0435\u0440\u043D\u043E, \u043F\u043B\u043E\u0442\u043D\u044B\u0439 \u0441\u044B\u0440\u043E\u0439 \u0432\u043E\u0437\u0434\u0443\u0445. \u041C\u043E\u0434\u0435\u043B\u0438 \u0440\u0435\u0430\u043B\u0438\u0441\u0442\u0438\u0447\u043D\u044B\u0435, \u043B\u044E\u0434\u0438 \u043F\u043E\u0445\u043E\u0436\u0438 \u043D\u0430 \u043B\u044E\u0434\u0435\u0439."
