  m_Name: S06_Storybook
  m_EditorClassIdentifier: Stealth.Game::Stealth.Configs.VisualStyle
  Title: "\u041A\u043D\u0438\u0436\u043A\u0430-\u0447\u0435\u0440\u0442\u0451\u0436"
  References: Blue Prince, Disco Elysium, The Wolf Among Us
  Pitch: "\u0414\u043E\u043C \u043A\u0430\u043A \u0438\u043B\u043B\u044E\u0441\u0442\u0440\u0430\u0446\u0438\u044F \u0438\u0437 \u0433\u0440\u0430\u0444\u0438\u0447\u0435\u0441\u043A\u043E\u0433\u043E \u0440\u043E\u043C\u0430\u043D\u0430: \u0430\u0440\u043A\u0438 \u0438 \u043F\u0438\u043B\u044F\u0441\u0442\u0440\u044B \u0443 \u0434\u0432\u0435\u0440\u0435\u0439, \u043A\u0435\u0441\u0441\u043E\u043D\u043D\u044B\u0439 \u043F\u043E\u0442\u043E\u043B\u043E\u043A, \u043F\u0430\u043D\u0435\u043B\u0438, \u043A\u0430\u0440\u043D\u0438\u0437\u044B, \u043F\u0430\u0440\u043A\u0435\u0442. \u0422\u043E\u043D\u043A\u0438\u0439 \u0447\u0435\u0440\u043D\u0438\u043B\u044C\u043D\u044B\u0439 \u043A\u043E\u043D\u0442\u0443\u0440, \u0441\u0435\u0440\u043E-\u0433\u043E\u043B\u0443\u0431\u044B\u0435 \u0441\u0442\u0435\u043D\u044B \u0438 \u0442\u0451\u043F\u043B\u044B\u0435 \u043B\u0430\u043C\u043F\u044B."
