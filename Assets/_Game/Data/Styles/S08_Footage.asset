  m_Name: S08_Footage
  m_EditorClassIdentifier: Stealth.Game::Stealth.Configs.VisualStyle
  Title: "\u041D\u0430\u0439\u0434\u0435\u043D\u043D\u0430\u044F \u043F\u043B\u0451\u043D\u043A\u0430"
  References: Content Warning, Paranormal VHS, [REC], Splinter Cell
  Pitch: "\u0412\u044B\u043B\u0430\u0437\u043A\u0430 \u0447\u0435\u0440\u0435\u0437 \u0434\u0435\u0448\u0451\u0432\u0443\u044E \u043A\u0430\u043C\u0435\u0440\u0443 \u0432 \u043D\u043E\u0447\u043D\u043E\u043C \u0440\u0435\u0436\u0438\u043C\u0435: \u0437\u0435\u043B\u0451\u043D\u0430\u044F \u043A\u0430\u0440\u0442\u0438\u043D\u043A\u0430 \u0441 \u0443\u0441\u0438\u043B\u0435\u043D\u0438\u0435\u043C, \u0441\u0442\u0440\u043E\u043A\u0438 \u0440\u0430\u0437\u0432\u0451\u0440\u0442\u043A\u0438, \u0448\u0443\u043C, \u043F\u0435\u0440\u0435\u0441\u0432\u0435\u0447\u0435\u043D\u043D\u044B\u0435 \u043B\u0430\u043C\u043F\u044B \u0438 REC. \u041F\u0440\u044F\u043C\u043E \u043F\u0440\u043E\u0441\u0438\u0442\u0441\u044F \u0437\u0430\u043F\u0438\u0441\u044C \u0437\u0430\u0431\u0435\u0433\u0430 \u0438 \u043F\u0440\u043E\u0441\u043C\u043E\u0442\u0440 \u0441 \u0434\u0440\u0443\u0437\u044C\u044F\u043C\u0438."
