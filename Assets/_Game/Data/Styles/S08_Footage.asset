  m_Name: S08_Footage
  m_EditorClassIdentifier: Stealth.Game::Stealth.Configs.VisualStyle
  Title: "\u041D\u0430\u0439\u0434\u0435\u043D\u043D\u0430\u044F \u043F\u043B\u0451\u043D\u043A\u0430"
  References: 'Content Warning, Paranormal VHS, [REC]'
  Pitch: "\u0412\u044B\u043B\u0430\u0437\u043A\u0443 \u0441\u043D\u0438\u043C\u0430\u0435\u0442 \u043A\u0430\u043C\u0435\u0440\u0430: \u0441\u0435\u0440\u044B\u0439 \u043C\u0438\u0440 \u0441 \u043A\u0430\u0440\u0430\u043D\u0434\u0430\u0448\u043D\u043E\u0439 \u0448\u0442\u0440\u0438\u0445\u043E\u0432\u043A\u043E\u0439 \u043D\u0430 \u0441\u0442\u0435\u043D\u0430\u0445, \u0431\u0435\u0442\u043E\u043D, \u0442\u0440\u0443\u0431\u044B \u0438 \u043A\u0430\u0431\u0435\u043B\u044C\u043D\u044B\u0435 \u043B\u043E\u0442\u043A\u0438. \u0426\u0432\u0435\u0442 \u043E\u0441\u0442\u0430\u0451\u0442\u0441\u044F \u0442\u043E\u043B\u044C\u043A\u043E \u0443 \u0441\u0432\u0435\u0442\u0430 \u2014 \u043B\u0430\u043C\u043F, \u044D\u043A\u0440\u0430\u043D\u043E\u0432, \u043B\u0430\u0437\u0435\u0440\u043E\u0432. \u0412\u0438\u0434\u043E\u0438\u0441\u043A\u0430\u0442\u0435\u043B\u044C, REC, \u0441\u0442\u0440\u043E\u043A\u0438 \u0440\u0430\u0437\u0432\u0451\u0440\u0442\u043A\u0438."
