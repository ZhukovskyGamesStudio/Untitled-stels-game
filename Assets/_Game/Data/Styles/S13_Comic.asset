  m_Name: S13_Comic
  m_EditorClassIdentifier: Stealth.Game::Stealth.Configs.VisualStyle
  Title: "\u041A\u043E\u043C\u0438\u043A\u0441-\u043F\u0443\u0441\u0442\u043E\u0448\u044C"
  References: "\u043F\u043E \u043C\u043E\u0442\u0438\u0432\u0430\u043C Borderlands"
  Pitch: "\u041D\u0430\u0440\u0438\u0441\u043E\u0432\u0430\u043D\u043D\u044B\u0439 \u043E\u0442 \u0440\u0443\u043A\u0438 \u043C\u0438\u0440 \u043D\u0430 \u043A\u0440\u0430\u044E \u043F\u0443\u0441\u0442\u044B\u043D\u0438: \u0436\u0438\u0440\u043D\u044B\u0439 \u0447\u0451\u0440\u043D\u044B\u0439 \u043A\u043E\u043D\u0442\u0443\u0440, \u0442\u0440\u0438 \u0441\u0442\u0443\u043F\u0435\u043D\u0438 \u0441\u0432\u0435\u0442\u0430, \u0448\u0442\u0440\u0438\u0445\u043E\u0432\u043A\u0430 \u0432 \u0442\u0435\u043D\u044F\u0445. \u0420\u0435\u0431\u0440\u0438\u0441\u0442\u043E\u0435 \u0436\u0435\u043B\u0435\u0437\u043E, \u0440\u0438\u0444\u043B\u0451\u043D\u044B\u0439 \u043F\u043E\u043B, \u0440\u0436\u0430\u0432\u044B\u0435 \u0431\u0430\u043B\u043A\u0438 \u0438 \u0442\u0440\u0443\u0431\u044B. \u0421\u043E\u0447\u043D\u043E, \u0442\u0435\u043F\u043B\u043E \u0438 \u043F\u044B\u043B\u044C\u043D\u043E."
