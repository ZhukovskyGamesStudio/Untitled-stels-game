  m_Name: S07_Logbook
  m_EditorClassIdentifier: Stealth.Game::Stealth.Configs.VisualStyle
  Title: "\u0411\u043E\u0440\u0442\u043E\u0432\u043E\u0439 \u0436\u0443\u0440\u043D\u0430\u043B"
  References: "Return of the Obra Dinn, \u0440\u0430\u043D\u043D\u0438\u0439 Macintosh"
  Pitch: "\u041E\u0434\u0438\u043D \u0431\u0438\u0442, \u0434\u0432\u0435 \u043A\u0440\u0430\u0441\u043A\u0438: \u043E\u043B\u0438\u0432\u043A\u043E\u0432\u044B\u0435 \u0447\u0435\u0440\u043D\u0438\u043B\u0430 \u0438 \u043C\u044F\u0442\u043D\u0430\u044F \u0431\u0443\u043C\u0430\u0433\u0430. \u0414\u043E\u043C \u043E\u0431\u0448\u0438\u0442 \u0434\u043E\u0441\u043A\u0430\u043C\u0438, \u043A\u0430\u043A \u043A\u043E\u0440\u0430\u0431\u043B\u044C, \u043F\u043E\u0434 \u043F\u043E\u0442\u043E\u043B\u043A\u043E\u043C \u0431\u0430\u043B\u043A\u0438. \u041A\u043E\u043D\u0442\u0443\u0440 \u0441\u0432\u0435\u0442\u043B\u044B\u0439 \u043D\u0430 \u0442\u0451\u043C\u043D\u043E\u043C \u0438 \u0442\u0451\u043C\u043D\u044B\u0439 \u043D\u0430 \u0441\u0432\u0435\u0442\u043B\u043E\u043C."
