  m_Name: S07_Logbook
  m_EditorClassIdentifier: Stealth.Game::Stealth.Configs.VisualStyle
  Title: "\u0411\u043E\u0440\u0442\u043E\u0432\u043E\u0439 \u0436\u0443\u0440\u043D\u0430\u043B"
  References: "Return of the Obra Dinn, \u0440\u0430\u043D\u043D\u0438\u0439 Macintosh"
  Pitch: "\u041E\u0434\u0438\u043D \u0431\u0438\u0442: \u0434\u0432\u0435 \u043A\u0440\u0430\u0441\u043A\u0438, \u0440\u0430\u0441\u0442\u0440\u043E\u0432\u044B\u0435 \u0442\u043E\u0447\u043A\u0438 \u0438 \u043A\u043E\u043D\u0442\u0443\u0440\u044B. \u0422\u0435\u043C\u043D\u043E\u0442\u0430 \u2014 \u044D\u0442\u043E \u0441\u043F\u043B\u043E\u0448\u043D\u044B\u0435 \u0447\u0435\u0440\u043D\u0438\u043B\u0430, \u0441\u0432\u0435\u0442 \u043B\u0430\u043C\u043F\u044B \u2014 \u043F\u044F\u0442\u043D\u043E \u0442\u043E\u0447\u0435\u043A. \u0421\u0430\u043C\u044B\u0439 \u0443\u0437\u043D\u0430\u0432\u0430\u0435\u043C\u044B\u0439 \u0438 \u0441\u0430\u043C\u044B\u0439 \u0441\u043C\u0435\u043B\u044B\u0439 \u0432\u0430\u0440\u0438\u0430\u043D\u0442."
