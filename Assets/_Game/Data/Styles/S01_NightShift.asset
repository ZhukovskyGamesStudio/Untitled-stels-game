  m_EditorClassIdentifier: Stealth.Game::Stealth.Configs.VisualStyle
  Title: "\u041D\u043E\u0447\u043D\u0430\u044F \u0441\u043C\u0435\u043D\u0430"
  References: Lethal Company, Content Warning
  Pitch: "\u041F\u0440\u043E\u043C\u0437\u043E\u043D\u0430 \u043D\u0430 \u043D\u043E\u0447\u043D\u043E\u0439 \u0441\u043C\u0435\u043D\u0435: \u0440\u0438\u0444\u043B\u0451\u043D\u044B\u0439 \u043F\u043E\u043B, \u0433\u043E\u0444\u0440\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u044B\u0435 \u0441\u0442\u0435\u043D\u044B, \u0442\u0440\u0443\u0431\u044B \u0438 \u0434\u0432\u0443\u0442\u0430\u0432\u0440\u044B \u043F\u043E\u0434 \u043F\u043E\u0442\u043E\u043B\u043A\u043E\u043C, \u043A\u0440\u0438\u0432\u043E\u0432\u0430\u0442\u044B\u0435 \u043C\u043E\u0434\u0435\u043B\u0438. \u041D\u0438\u0437\u043A\u043E\u0435 \u0440\u0430\u0437\u0440\u0435\u0448\u0435\u043D\u0438\u0435, \u0441\u0442\u0443\u043F\u0435\u043D\u0438 \u0441\u0432\u0435\u0442\u0430, \u0434\u044B\u043C\u043A\u0430 \u0438 \u043A\u0440\u0430\u0439 \u0448\u043B\u0435\u043C\u0430 \u043F\u043E \u0440\u0430\u043C\u043A\u0435 \u043A\u0430\u0434\u0440\u0430."
